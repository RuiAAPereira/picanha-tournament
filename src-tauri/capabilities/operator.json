{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "operator",
  "description": "The operator window: storage, and control of the TV window through the app's own commands.",
  "windows": ["operator"],
  "permissions": [
    "core:default",
    "allow-load-current-tournament",
    "allow-save-tournament",
    "allow-list-tournaments",
    "allow-export-backup",
    "allow-list-presentation-displays",
    "allow-open-presentation-window",
    "allow-close-presentation-window",
    "allow-publish-presentation-state",
    "allow-get-presentation-state",
    "allow-skip-presentation",
    "allow-set-presentation-muted"
  ]
}
